          "text": "Use H=Y/X."
        },
        {
          "step": 2,
          "text": "(3+2e^{-jΩ}-3e^{-j3Ω})Y=(1+2e^{-j2Ω})X."
        },
        {
          "step": 3,
          "text": "Use e^{-jΩk}Y ↔ y[n-k] and e^{-jΩk}X ↔ x[n-k]."
        },
        {
          "step": 4,
          "text": "Convert each term to get 3y[n]+2y[n-1]-3y[n-3]=x[n]+2x[n-2]."
        }
      ],
      "key_formulas": [
        "H(e^{j\\Omega})=Y(e^{j\\Omega})/X(e^{j\\Omega})",
        "e^{-j\\Omega k}Y(e^{j\\Omega})\\leftrightarrow y[n-k]"
      ],
      "tags": [
        "DTFT",
        "difference equation"
      ]
    },
