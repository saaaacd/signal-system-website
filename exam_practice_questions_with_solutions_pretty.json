      ],
      "difficulty": "easy",
      "prompt": "Find the difference equation corresponding to the system with frequency response H(e^{jΩ})=(1+2e^{-j2Ω})/(3+2e^{-jΩ}-3e^{-j3Ω}).",
      "latex": {
        "main": "H(e^{j\\Omega})=\\frac{1+2e^{-j2\\Omega}}{3+2e^{-j\\Omega}-3e^{-j3\\Omega}}"
      },
      "final_answer": {
        "main": "3y[n]+2y[n-1]-3y[n-3]=x[n]+2x[n-2]"
      },
      "solution_steps": [
