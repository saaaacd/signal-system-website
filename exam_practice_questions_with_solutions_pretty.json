      "id": "q010",
      "title": "LTI response and proof of convolution property",
      "type": "proof",
      "chapter": "3",
      "sections": [
        "3.7",
        "3.10"
      ],
      "difficulty": "medium",
      "prompt": "(a) The output of an LTI system in response to x(t)=e^{-2t}u(t) is y(t)=e^{-t}u(t). Find the frequency response and the impulse response.\n(b) Prove that y(t)=h(t)*x(t) ↔ Y(jω)=H(jω)X(jω).",
      "latex": {
        "a": "x(t)=e^{-2t}u(t),\\quad y(t)=e^{-t}u(t)",
        "b": "y(t)=h(t)*x(t)\\overset{FT}{\\Longleftrightarrow}Y(j\\omega)=H(j\\omega)X(j\\omega)"
      },
      "final_answer": {
        "a": "H(j\\omega)=\\frac{j\\omega+2}{j\\omega+1},\\quad h(t)=\\delta(t)+e^{-t}u(t)",
        "b": "Y(j\\omega)=H(j\\omega)X(j\\omega)"
      },
      "solution_steps": [
        {
          "part": "a",
          "step": 1,
          "text": "X=1/(jω+2), Y=1/(jω+1)."
        },
        {
          "part": "a",
          "step": 2,
          "text": "H=Y/X=(jω+2)/(jω+1)."
        },
        {
          "part": "a",
