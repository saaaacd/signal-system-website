    {
      "id": "q006",
      "title": "Differential and difference equations from impulse responses",
      "type": "system_equation",
      "chapter": "3",
      "sections": [
        "3.6",
        "3.7",
        "3.11",
        "3.13"
      ],
      "difficulty": "hard",
      "prompt": "Determine the differential- or difference-equation descriptions for systems with impulse responses: (a) h(t)=2e^{-2t}u(t)-2te^{-2t}u(t). (b) h[n]=δ[n]+2(1/2)^n u[n]+(-1/2)^n u[n].",
      "latex": {
        "a": "h(t)=2e^{-2t}u(t)-2te^{-2t}u(t)",
        "b": "h[n]=\\delta[n]+2(\\frac12)^n u[n]+(-\\frac12)^n u[n]"
      },
      "final_answer": {
        "a": "\\frac{d^2y(t)}{dt^2}+4\\frac{dy(t)}{dt}+4y(t)=2\\frac{dx(t)}{dt}+2x(t)",
        "b": "y[n]-\\frac14y[n-2]=4x[n]+\\frac12x[n-1]-\\frac14x[n-2]"
      },
      "solution_steps": [
        {
          "part": "a",
          "step": 1,
          "text": "Transform h(t): H=2/(2+jω)-2/(2+jω)^2."
        },
        {
          "part": "a",
          "step": 2,
          "text": "Combine: H=(2+2jω)/(2+jω)^2."
        },
        {
          "part": "a",
          "step": 3,
          "text": "Use H=Y/X, so (2+jω)^2Y=(2+2jω)X."
        },
        {
          "part": "a",
          "step": 4,
          "text": "Expand (2+jω)^2=4+4jω+(jω)^2."
        },
        {
          "part": "a",
          "step": 5,
          "text": "Convert jω to d/dt and (jω)^2 to d²/dt²."
        },
        {
          "part": "b",
          "step": 1,
          "text": "Transform h[n]: H=1+2/(1-(1/2)e^{-jΩ})+1/(1+(1/2)e^{-jΩ})."
        },
        {
          "part": "b",
          "step": 2,
          "text": "Let q=e^{-jΩ}. Common denominator is (1-q/2)(1+q/2)=1-q²/4."
        },
        {
          "part": "b",
          "step": 3,
          "text": "Numerator: (1-q²/4)+2(1+q/2)+(1-q/2)=4+q/2-q²/4."
        },
        {
          "part": "b",
          "step": 4,
          "text": "Thus H=(4+(1/2)q-(1/4)q²)/(1-(1/4)q²)."
        },
        {
          "part": "b",
          "step": 5,
          "text": "Use H=Y/X and convert q^kY ↔ y[n-k], q^kX ↔ x[n-k]."
        }
      ],
      "key_formulas": [
        "H=Y/X",
        "j\\omega Y\\leftrightarrow dy/dt",
        "(j\\omega)^2Y\\leftrightarrow d^2y/dt^2",
        "\\delta[n]\\leftrightarrow 1",
        "a^n u[n]\\leftrightarrow \\frac1{1-ae^{-j\\Omega}}"
      ],
      "tags": [
        "impulse response",
        "differential equation",
        "difference equation"
      ]
    },
